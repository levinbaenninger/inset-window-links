{
  "name": "inset-window-links",
  "version": "0.1.0",
  "private": true,
  "description": "Collect several real window views and write the one thought that connects them.",
  "license": "UNLICENSED",
  "author": "Levin Bänninger <levin@baenninger.me>",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "package:dir": "pnpm build && electron-builder --dir",
    "verify:desktop": "pnpm build && node scripts/verify-desktop.ts",
    "verify:packaged": "pnpm package:dir && node scripts/verify-desktop.ts --packaged",
    "verify:packaged:current": "node scripts/verify-desktop.ts --packaged",
    "verify:update": "node scripts/verify-update.ts",
    "verify:windows": "pnpm build && node scripts/verify-windows.ts",
    "verify:windows:packaged": "pnpm package:dir && node scripts/verify-windows.ts --packaged",
    "icon": "electron scripts/render-icon.mjs",
    "screens": "pnpm build && node scripts/screens.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "get-windows": "10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/lint": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "ultracite": "^8.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Inset Window Links"
}
